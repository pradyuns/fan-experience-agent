# local development environment variables.
FAN_DATABASE_URL=postgresql+asyncpg://fan_experience:fan_experience@localhost:5432/fan_experience
FAN_REDIS_URL=redis://localhost:6379/0
FAN_ANTHROPIC_API_KEY=
FAN_WEBHOOK_HMAC_SECRET=dev-secret
FAN_TELEMETRY_ENABLED=true
FAN_TELEMETRY_SERVICE_NAME=fan-experience-agent
FAN_TELEMETRY_ENV=dev
FAN_TELEMETRY_LOG_LEVEL=INFO
FAN_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
FAN_OTEL_TRACE_SAMPLE_RATIO=1.0
FAN_OTEL_METRICS_EXPORT_INTERVAL_MS=10000

# docker compose postgres credentials.
POSTGRES_DB=fan_experience
POSTGRES_USER=fan_experience
POSTGRES_PASSWORD=fan_experience
